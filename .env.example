# Variables publiques du client. Ne jamais utiliser de clé service_role ici.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-local-anon-key

# Secrets des Edge Functions du pont OAuth (jamais exposés au client Vite).
# Générer QUIZ_TSI_OAUTH_BRIDGE_SECRET avec 32 octets aléatoires encodés en
# base64url sans padding, par exemple : openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SUPABASE_URL=https://PROJECT_REF.supabase.co
QUIZ_TSI_GPT_OAUTH_CLIENT_ID=replace-with-supabase-oauth-client-id
QUIZ_TSI_GPT_OAUTH_CLIENT_SECRET=replace-with-supabase-oauth-client-secret
QUIZ_TSI_GPT_REDIRECT_URI=https://chat.openai.com/aip/g-6911186baceee17745bfc3e22a1736d6a7c5b084/oauth/callback
QUIZ_TSI_OAUTH_BRIDGE_CALLBACK_URL=https://PROJECT_REF.supabase.co/functions/v1/gpt-oauth-callback
QUIZ_TSI_OAUTH_BRIDGE_SECRET=replace-with-32-random-bytes-as-base64url
